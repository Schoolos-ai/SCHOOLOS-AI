      if (name.includes("ai")) return `Explore sample ${feature} screens. AI output is not live in this offline demo.`;
      if (name.includes("account") || name.includes("security")) return `Preview ${feature} using fictional data; no real account settings are changed.`;
      if (name.includes("school") || name.includes("staff") || name.includes("student") || name.includes("class")) return `Browse a fictional ${feature.toLowerCase()} sample for this role.`;
      if (name.includes("email") || name.includes("mail")) return `Preview ${feature} with sample content. No real email is sent or received.`;
      return `Explore a fictional ${feature.toLowerCase()} workflow for the selected portal. Actions remain in demo mode.`;
    }

    function renderRoles() {
      roleNav.replaceChildren();
      roleKeys.forEach((key) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "role-button";
        button.setAttribute("aria-pressed", String(key === selectedRole));
        button.textContent = `${roles[key].glyph}  ${roles[key].label}  ${roles[key].features.length}`;
        button.addEventListener("click", () => {
          selectedRole = key;
          selectedFeature = "Overview";
          search.value = "";
          render();
        });
        roleNav.append(button);
      });
    }

    function renderFeatures() {
      const currentRole = roles[selectedRole];
      const term = search.value.trim().toLowerCase();
      const matches = currentRole.features.filter((feature) => feature.toLowerCase().includes(term));
      featureNav.replaceChildren();
      document.getElementById("feature-count").textContent = String(currentRole.features.length);
      document.getElementById("role-label").textContent = `${currentRole.label.toUpperCase()} PORTAL`;
      matches.forEach((feature) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "feature-button";
        button.textContent = feature;
        if (feature === selectedFeature) button.setAttribute("aria-current", "page");
        button.addEventListener("click", () => {
          selectedFeature = feature;
          renderPreview();
          renderFeatures();
        });
        featureNav.append(button);
      });
      if (!matches.length) {
        const empty = document.createElement("p");
        empty.textContent = "No features match this search.";
        featureNav.append(empty);
      }
    }

    function addAction(label, response) {
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = label;
      button.addEventListener("click", () => {
        document.getElementById("feedback").textContent = response;
      });
      document.getElementById("interaction").append(button);
    }

    function renderPreview() {
      const currentRole = roles[selectedRole];
      const isOverview = selectedFeature === "Overview";
      document.getElementById("screen-title").textContent = isOverview ? currentRole.greeting : selectedFeature;
      document.getElementById("screen-subtitle").textContent = currentRole.context;
      document.getElementById("role-glyph").textContent = currentRole.glyph;
      document.getElementById("footer-role").textContent = `Showing ${currentRole.label} portal sample - ${currentRole.features.length} features`;
      document.getElementById("preview-title").textContent = isOverview ? "A quick look around" : "Feature sample";
      document.getElementById("preview-description").textContent = isOverview
        ? `This is a fictional ${currentRole.label.toLowerCase()} workspace. Select any feature to open its sample preview.`
        : describe(selectedFeature);
      document.getElementById("feedback").textContent = "";

      const stats = document.getElementById("stats");
      stats.replaceChildren();
      currentRole.stats.forEach(([label, value, note]) => {
        const card = document.createElement("article");
        card.className = "stat";
        const labelNode = document.createElement("span");
        labelNode.textContent = label;
        const valueNode = document.createElement("strong");
        valueNode.textContent = value;
        const noteNode = document.createElement("small");
        noteNode.textContent = note;
        card.append(labelNode, valueNode, noteNode);
        stats.append(card);
      });

      const interaction = document.getElementById("interaction");
      interaction.replaceChildren();
      if (isOverview) {
        addAction("Open a sample dashboard card", "Sample card opened. No account data was loaded.");
        addAction("Explore this portal's first feature", "Choose a feature from the list to open its sample screen.");
      } else if (/quiz|game|tutor|flashcard/i.test(selectedFeature)) {
        addAction("Choose sample answer: Option A", "Demo answer recorded locally. No score was submitted.");
        addAction("Show another sample", "Another fictional example is ready to explore.");
      } else if (/attendance|marks|progress|analytics|readiness/i.test(selectedFeature)) {
        addAction("Open sample record", "Fictional sample record opened. No real learner record was accessed.");
        addAction("Filter sample view", "Sample view filtered locally; no school data was requested.");
      } else if (/message|question|complaint|form|notice|emergency|email/i.test(selectedFeature)) {
        addAction("Preview sample message", "Fictional message preview opened. Nothing was sent or submitted.");
        addAction("Save as local demo draft", "Saved only in this page's temporary demo state.");
      } else {
        addAction("Open sample preview", "Sample preview opened. This demonstration does not save or send anything.");
        addAction("Show sample details", "Details shown are fictional and remain on this device.");
      }
    }

    function render() {
      renderRoles();
      renderFeatures();
      renderPreview();
    }

    search.addEventListener("input", renderFeatures);
    document.getElementById("reset-demo").addEventListener("click", () => {
      selectedRole = "student";
      selectedFeature = "Overview";
      search.value = "";
      render();
      document.getElementById("feedback").textContent = "Demo reset. All sample screens are ready.";
    });
    render();
  </script>
</body>
</html>

